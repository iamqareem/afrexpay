# Copy to .env and fill in for production. docker-compose reads this automatically.
POSTGRES_USER=afrexlab
POSTGRES_PASSWORD=changeme
POSTGRES_DB=afrexlab
JWT_SECRET=change-this-in-production
BASE_DOMAIN=afrexlab.com
# How long a resolved tenant stays cached in-process before the next
# request re-checks Postgres. Default 30000 (30s) if unset.
TENANT_CACHE_TTL_MS=30000
MATRIX_HOMESERVER_URL=http://localhost:8008
MATRIX_ACCESS_TOKEN=
# Optional — password reset links are logged to the console if SMTP isn't
# configured, which is enough for local dev/testing without mail credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# For local testing of the full signup -> dashboard flow, add fake subdomain
# entries to /etc/hosts (e.g. afrexlab.local, 256-merch.afrexlab.local) rather
# than using BASE_DOMAIN=localhost — see README "Signup flow" for why.
